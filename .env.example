# MODO_FAKE=1 roda tudo em memória (sem Supabase/Asaas/Google) para dev e testes.
# Uma lista troca só algumas portas: MODO_FAKE=pagamentos,calendario usa o Supabase real.
# NUNCA defina MODO_FAKE nem as NEXT_PUBLIC_*_FAKE em produção.
# Em produção defina AMBIENTE=producao: o app se recusa a subir com MODO_FAKE ligado.
MODO_FAKE=1
# Login fake no painel (só faz sentido com MODO_FAKE=1).
NEXT_PUBLIC_MODO_FAKE=1
# Botão "Simular pagamento" com banco/login reais (quando "pagamentos" está fake no servidor).
NEXT_PUBLIC_PAGAMENTO_FAKE=

# E-mails autorizados no painel admin, separados por vírgula.
ADMIN_EMAILS=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# https://api-sandbox.asaas.com/v3 (sandbox) | https://api.asaas.com/v3 (produção)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# A chave começa com $: escreva com barra invertida (\$aact_...) ou o Next a lê vazia.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Carteira da plataforma (outra conta Asaas). Vazio = cobrança sem split.
ASAAS_SPLIT_WALLET_ID=
# Use um dos dois (fixo em reais ou percentual 0-100).
ASAAS_SPLIT_FIXO=
ASAAS_SPLIT_PERCENTUAL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

NEXT_PUBLIC_WHATSAPP_BARBEARIA=5511999998888
